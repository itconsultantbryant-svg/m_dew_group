# ---------------------------------------------------------------------------
# Mountain Dew Group - example environment variables. Copy to `.env` and fill in.
# NEVER commit real secrets. Values below are development placeholders.
# ---------------------------------------------------------------------------

# --- Database ---
# Local PostgreSQL (default for development):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mountain_dew_dev?schema=public"
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/mountain_dew_test?schema=public"
# Neon (production). Copy the two connection strings Neon shows, adding
# ?sslmode=require. The pooled endpoint is for the running app; the unpooled
# ("direct") endpoint is used only by `prisma migrate`/introspection.
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/mountain_dew_dev?schema=public"

# --- API ---
NODE_ENV="development"
API_PORT="4100"
API_HOST="0.0.0.0"
# Comma separated list of allowed browser origins
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
# Public base URL used to build shareable links in emails
PUBLIC_WEB_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:4100"

# 32+ byte random strings. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-48-byte-random-string"
MANAGE_LINK_SECRET="replace-with-48-byte-random-string"
CSRF_SECRET="replace-with-48-byte-random-string"

# Access token lifetime (minutes) and refresh lifetime (days)
ACCESS_TOKEN_TTL_MINUTES="30"
REFRESH_TOKEN_TTL_DAYS="30"
HOLD_TTL_MINUTES="15"

# Staff MFA (TOTP) - set to "true" to require for privileged roles
REQUIRE_STAFF_MFA="false"

# --- Media / object storage (S3 compatible) ---
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="true"

# --- Notifications (leave blank to run in "logged/limited" mode) ---
# When credentials are missing the system reports a configuration limitation
# rather than pretending the message was delivered.
EMAIL_PROVIDER=""
EMAIL_FROM="reservations@example.com"
SMTP_URL=""
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""
WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""
EXPO_PUSH_ACCESS_TOKEN=""

# --- Payment providers (none required for pay-at-property) ---
# These record methods only; leaving them blank keeps pay-at-property behaviour.
FLUTTERWAVE_SECRET_KEY=""
STRIPE_SECRET_KEY=""

# --- Rate limiting ---
RATE_LIMIT_HOLD_PER_HOUR="20"
RATE_LIMIT_LOGIN_PER_15MIN="10"

# --- Mobile ---
EXPO_PUBLIC_API_URL="http://localhost:4100"

# --- Web / Vercel ---
# Public origin of the API. On Vercel this is the deployed API project URL,
# e.g. "https://mountain-dew-api.vercel.app". Baked in at build time.
NEXT_PUBLIC_API_URL="http://localhost:4100"
